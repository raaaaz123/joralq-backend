# Postgres connection string from Supabase: Project Settings > Database > Connection string (URI).
# Use the session pooler (port 5432) or direct connection.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
# Supabase project URL and anon key: used only to verify access tokens (auth.getUser).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# Service role key: ONLY needed by the seed script (creates demo auth users). Never ship it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated origins allowed by CORS (the Next.js app).
CORS_ORIGINS=http://localhost:3000
PORT=4000
